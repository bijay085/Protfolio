# Start the main stylesheet as soon as the HTML response begins.
# The HTML still owns the stylesheet link, so this preload is reused rather than duplicated.
/
  Link: </assets/css/style.css?v=20261018-4>; rel=preload; as=style

# Long-lived immutable assets are versioned or content-addressed by the site.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/image/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/favicon_io/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
